generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  avatar    String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  favorites Favorite[]
  history   History[]
  comments  Comment[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Series {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  cover       String
  banner      String?
  status      SeriesStatus
  type        SeriesType
  releaseYear Int
  author      String
  artist      String
  sourceUrl   String?
  createdAt   DateTime @default(now())

  genres    SeriesGenre[]
  chapters  Chapter[]
  favorites Favorite[]

  @@map("series")
}

enum SeriesStatus {
  ONGOING
  COMPLETED
  HIATUS
}

enum SeriesType {
  MANHWA
  MANGA
  WEBTOON
}

model Genre {
  id     String @id @default(uuid())
  name   String @unique
  slug   String @unique

  series SeriesGenre[]

  @@map("genres")
}

model SeriesGenre {
  seriesId String
  genreId  String

  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([seriesId, genreId])
  @@map("series_genres")
}

model Chapter {
  id         String   @id @default(uuid())
  seriesId   String
  number     Float
  title      String?
  mangadexId String?
  sourceUrl  String?
  createdAt  DateTime @default(now())

  series   Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  pages    Page[]
  history  History[]
  comments Comment[]

  @@map("chapters")
}

model Page {
  id         String @id @default(uuid())
  chapterId  String
  pageNumber Int
  imageUrl   String
  width      Int?
  height     Int?

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@map("pages")
}

model Favorite {
  userId   String
  seriesId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([userId, seriesId])
  @@map("favorites")
}

model History {
  userId    String
  chapterId String
  page      Int      @default(1)
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([userId, chapterId])
  @@map("history")
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  chapterId String
  message   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@map("comments")
}
