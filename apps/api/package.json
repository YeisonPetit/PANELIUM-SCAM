{
  "name": "@inkverse/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "studio": "node --env-file=../../.env ../../node_modules/prisma/build/index.js studio --port 5555",
    "build": "tsc",
    "start": "npx prisma db push --skip-generate && node dist/index.js",
    "generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@consumet/extensions": "^1.8.8",
    "@panelium/types": "*",
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.10.2",
    "sharp": "^0.35.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.24",
    "prisma": "^5.10.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
